<!DOCTYPE html>
<html lang="et">
<head>
    <meta charset="utf-8">
    <title>Ameti lisamine</title>
</head>
<body>
    <h1>Filmiga seotud ameti lisamine</h1>
    <p>Siin lehel saab lisada filmidega seotud ameteid.</p>
    <hr>
    <ul>
        <li><a href="/">Avalehele</a></li>
        <li><a href="/eestifilm">Eesti filmi avaleht</a></li>
    </ul>
    <hr>
    <form method="POST" action="/amet_add">
        <label for="titleInput">Ameti nimetus</label>
        <input id="titleInput" name="titleInput" type="text" maxlength="50" required value="<%= titleInput %>">
        <br>
        <label for="descriptionInput">Kirjeldus</label>
        <textarea id="descriptionInput" name="descriptionInput" maxlength="1000"><%= descriptionInput %></textarea>
        <br>
        <input type="submit" value="Salvesta">
        </form>
	<p><%= notice %></p>
</body>
</html>